// Subscription Management System - Prisma schema (PostgreSQL)
// Money: Decimal(12,2). Percent rates: Decimal(5,2) (e.g. 18.00 = 18%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── ENUMS ─────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  SERVICE
  ADDON
  GOODS
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT       // applies to lines of selected products
  SUBSCRIPTION  // applies to the whole subscription subtotal
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

// ───────────── AUTH & USERS ─────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique // one account per email (store lowercased)
  passwordHash String
  name         String
  phone        String?
  company      String?
  address      String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetTokens           PasswordResetToken[]
  subscriptions         Subscription[]       @relation("CustomerSubscriptions")
  createdSubscriptions  Subscription[]       @relation("SubscriptionCreator")
  invoices              Invoice[]
  recordedPayments      Payment[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // store SHA-256 hash, never the raw token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── CATALOG ─────────────

model Product {
  id         String      @id @default(cuid())
  name       String
  type       ProductType
  salesPrice Decimal     @db.Decimal(12, 2)
  costPrice  Decimal     @db.Decimal(12, 2)
  notes      String?
  isActive   Boolean     @default(true)
  taxId      String?     // default tax for this product
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tax              Tax?                    @relation(fields: [taxId], references: [id])
  variants         ProductVariant[]
  discounts        DiscountProduct[]
  templateLines    QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines     InvoiceLine[]

  @@index([name])
  @@index([isActive])
}

// e.g. attribute "Brand", value "Odoo", extraPrice 560
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  attribute  String
  value      String
  extraPrice Decimal @default(0) @db.Decimal(12, 2)

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]

  @@unique([productId, attribute, value])
}

model Plan {
  id            String        @id @default(cuid())
  name          String
  price         Decimal       @db.Decimal(12, 2)
  billingPeriod BillingPeriod
  minQuantity   Int           @default(1)
  startDate     DateTime      // available from
  endDate       DateTime?     // available until
  autoClose     Boolean       @default(false) // closes by itself at end
  closable      Boolean       @default(true)  // can be closed early
  pausable      Boolean       @default(false)
  renewable     Boolean       @default(true)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subscriptions Subscription[]
  templates     QuotationTemplate[]

  @@index([isActive, startDate, endDate])
}

model Tax {
  id        String   @id @default(cuid())
  name      String   // e.g. "GST 18%"
  rate      Decimal  @db.Decimal(5, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products          Product[]
  subscriptionLines SubscriptionLine[]
}

model Discount {
  id          String        @id @default(cuid())
  name        String
  type        DiscountType
  value       Decimal       @db.Decimal(12, 2) // amount or percent
  scope       DiscountScope
  minPurchase Decimal?      @db.Decimal(12, 2)
  minQuantity Int?
  startDate   DateTime
  endDate     DateTime
  usageLimit  Int?          // null = unlimited
  usedCount   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  products      DiscountProduct[]
  subscriptions Subscription[]
  invoiceUses   InvoiceDiscount[]

  @@index([isActive, startDate, endDate])
}

model DiscountProduct {
  discountId String
  productId  String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
}

// ───────────── QUOTATION TEMPLATES ─────────────

model QuotationTemplate {
  id           String   @id @default(cuid())
  name         String
  planId       String
  validityDays Int      @default(30)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  plan          Plan                    @relation(fields: [planId], references: [id])
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]
}

model QuotationTemplateLine {
  id         String  @id @default(cuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int     @default(1)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])
}

// ───────────── SUBSCRIPTIONS ─────────────

model Subscription {
  id               String             @id @default(cuid())
  number           String             @unique // SUB-000001 (from Counter)
  customerId       String
  planId           String
  templateId       String?
  discountId       String?            // subscription-level discount
  status           SubscriptionStatus @default(DRAFT)
  startDate        DateTime
  expiryDate       DateTime
  nextBillingDate  DateTime?          // set when ACTIVE; null when paused/closed
  paymentTermDays  Int                @default(15) // invoice due = issue + N days
  quotationValidUntil DateTime?
  notes            String?
  createdById      String
  closedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  customer  User               @relation("CustomerSubscriptions", fields: [customerId], references: [id])
  createdBy User               @relation("SubscriptionCreator", fields: [createdById], references: [id])
  plan      Plan               @relation(fields: [planId], references: [id])
  template  QuotationTemplate? @relation(fields: [templateId], references: [id])
  discount  Discount?          @relation(fields: [discountId], references: [id])
  lines     SubscriptionLine[]
  invoices  Invoice[]

  @@index([status])
  @@index([customerId])
  @@index([status, nextBillingDate]) // billing run query
  @@index([expiryDate])
}

model SubscriptionLine {
  id             String   @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2) // plan/product price + variant extra
  taxId          String?
  amount         Decimal  @db.Decimal(12, 2) // quantity * unitPrice (pre-tax)

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  tax          Tax?            @relation(fields: [taxId], references: [id])

  @@index([subscriptionId])
}

// ───────────── INVOICES & PAYMENTS ─────────────

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique // INV-000001 (from Counter)
  subscriptionId String
  customerId     String
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime
  periodEnd      DateTime
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription      @relation(fields: [subscriptionId], references: [id])
  customer     User              @relation(fields: [customerId], references: [id])
  lines        InvoiceLine[]
  discounts    InvoiceDiscount[]
  payments     Payment[]

  // Idempotency: one invoice per subscription per billing period
  @@unique([subscriptionId, periodStart])
  @@index([customerId])
  @@index([status, dueDate]) // overdue queries
  @@index([issueDate])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2) // snapshot at billing time
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2) // pre-tax line amount

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

// Records which discount was applied to which invoice (usage tracking)
model InvoiceDiscount {
  id         String  @id @default(cuid())
  invoiceId  String
  discountId String
  amount     Decimal @db.Decimal(12, 2)

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id])

  @@unique([invoiceId, discountId])
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paymentDate  DateTime
  note         String?
  recordedById String
  createdAt    DateTime      @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
}

// ───────────── SEQUENCES ─────────────

// Atomic number generation: UPDATE ... SET value = value + 1 RETURNING value
model Counter {
  key   String @id // "subscription", "invoice"
  value Int    @default(0)
}
