# Copy to .env (never commit .env)

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscriptions?schema=public"

# API
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE=false
CLIENT_URL="http://localhost:5173"

# Email (use Ethereal/Mailtrap for demo)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="RevenIQ <no-reply@reveniq.test>"

# Billing
BILLING_CRON="30 0 * * *"
AUTO_CONFIRM_INVOICES=true

# Web (apps/web/.env)
VITE_API_URL="http://localhost:4000/api/v1"

